# Runtime profile and safety limits
TRIALPULSE_ENVIRONMENT=development
TRIALPULSE_LOG_LEVEL=INFO
TRIALPULSE_ALLOWED_HOSTS=["*"]
TRIALPULSE_CORS_ORIGINS=[]
TRIALPULSE_MAX_REQUEST_BYTES=5000000
TRIALPULSE_RATE_LIMIT_PER_MINUTE=240
